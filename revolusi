-- AUTO BLACK MARKET + SERVER HOP
-- ================================================================
local AutoBMHop = {}
do
    local Workspace       = service.Workspace
    local Players         = service.Players
    local TeleportService = service.TeleportService
    local ReplicatedStorage = service.ReplicatedStorage

    local state = {
        selectedIds = {},
        running     = false,
        loopThread  = nil,
        onStatus    = nil,
    }

    local RF_PurchaseItem, hopRemote
    local BlackMarketConfig, Replion, CurrencyUtility
    local bmRep, playerDataRep, serverBrowserRep

    local suffixes = {"", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc"}

    local function formatNumber(n)
        if not tonumber(n) then return "0" end
        n = math.floor(n)
        local abs_n = math.abs(n)
        if abs_n < 1000 then return tostring(n) end

        local power = math.floor(math.log10(abs_n) / 3)
        if power > #suffixes - 1 then power = #suffixes - 1 end

        local value = n / math.pow(1000, power)
        local formatted = string.format("%.2f", value):gsub("%.?0+$", "")
        return formatted .. suffixes[power + 1]
    end

    local function font(text, color)
        return ("<font color='%s'>%s</font>"):format(color, text)
    end

    local function formatCountdown(seconds)
        local s = math.max(math.floor(seconds), 0)
        local h = math.floor(s / 3600)
        local m = math.floor((s % 3600) / 60)
        local sc = s % 60
        return ("%02d:%02d:%02d"):format(h, m, sc)
    end

    function AutoBMHop.Init()
        if not _G.Net then
            warn("[AutoBMHop] _G.Net belum siap")
            return false
        end

        RF_PurchaseItem = _G.Net.PurchaseBlackMarketItem
        hopRemote        = _G.Net.ServerHop

        local ok = pcall(function()
            BlackMarketConfig = require(ReplicatedStorage.Shared.BlackMarketConfig)
            Replion           = require(ReplicatedStorage.Packages.Replion).Client
            CurrencyUtility   = require(ReplicatedStorage.Modules.CurrencyUtility)
        end)
        if not ok then
            warn("[AutoBMHop] Gagal require dependencies Black Market")
            return false
        end

        task.wait(0.5)

        bmRep         = Replion:WaitReplion(BlackMarketConfig.ChannelName, 5)
        playerDataRep = Replion:WaitReplion("Data", 5)
        pcall(function() serverBrowserRep = Replion:WaitReplion("ServerBrowser", 10) end)

        if not bmRep or not playerDataRep then
            warn("[AutoBMHop] Replion data gagal diload")
            return false
        end

        return true
    end

    function AutoBMHop.GetItemOptions()
        local names, nameToId = {}, {}
        if not BlackMarketConfig then return names, nameToId end

        for _, itemData in ipairs(BlackMarketConfig.GetItems()) do
            if itemData.Currency == "Coins" then
                table.insert(names, itemData.DisplayName)
                nameToId[itemData.DisplayName] = itemData.Id
            end
        end
        return names, nameToId
    end

    function AutoBMHop.SetSelectedIds(ids)
        state.selectedIds = ids or {}
    end

    function AutoBMHop.HasSelection()
        return #state.selectedIds > 0
    end

    function AutoBMHop.SetOnStatus(fn)
        state.onStatus = fn
    end

    local function getStockEntries()
        return bmRep:Get("Items") or {}
    end

    local function getPlayerCoins()
        local coinPath = CurrencyUtility:GetCurrency("Coins").Path
        return playerDataRep:Get(coinPath) or 0
    end

    local function getNextRestockSeconds()
        local nextRestock = bmRep:Get("NextRestock")
        if not nextRestock or nextRestock <= 0 then return 0 end
        return math.max(nextRestock - math.floor(Workspace:GetServerTimeNow()), 0)
    end

    local function getDealerPart()
        local dealerName = BlackMarketConfig.DealerName or "Blackmarket Dealer"
        for _, v in ipairs(Workspace:GetDescendants()) do
            if v.Name == dealerName and v:IsA("BasePart") then
                return v
            end
        end
        return nil
    end

    local function getAvailableItems()
        local stockEntries = getStockEntries()
        local coins = getPlayerCoins()
        local available = {}

        for _, itemId in ipairs(state.selectedIds) do
            local itemData = BlackMarketConfig.GetItem(itemId)
            if itemData and itemData.Currency == "Coins" then
                local stockInfo = stockEntries[itemId]
                local currentStock = stockInfo and stockInfo.Stock or 0
                if currentStock > 0 and coins >= itemData.Price then
                    table.insert(available, itemId)
                end
            end
        end
        return available
    end

    local function anyStockLeft()
        local stockEntries = getStockEntries()
        for _, itemId in ipairs(state.selectedIds) do
            local stockInfo = stockEntries[itemId]
            if (stockInfo and stockInfo.Stock or 0) > 0 then return true end
        end
        return false
    end

    local function canAffordCheapest()
        local coins = getPlayerCoins()
        for _, itemId in ipairs(state.selectedIds) do
            local itemData = BlackMarketConfig.GetItem(itemId)
            if itemData and itemData.Currency == "Coins" and coins >= itemData.Price then
                return true
            end
        end
        return false
    end

    local function buildStatusText()
        local stockEntries = getStockEntries()
        local coins = getPlayerCoins()
        local seconds = getNextRestockSeconds()
        local lines = {}

        lines[#lines + 1] = "Coins: " .. font("<b>" .. formatNumber(coins) .. "</b>", "rgb(255,220,80)")
        lines[#lines + 1] = ""
        lines[#lines + 1] = "<b>Item dipilih:</b>"

        if #state.selectedIds == 0 then
            lines[#lines + 1] = font("Belum ada item dipilih & disimpan", "rgb(200,200,200)")
        else
            for _, itemId in ipairs(state.selectedIds) do
                local itemData = BlackMarketConfig.GetItem(itemId)
                if itemData then
                    local stockInfo = stockEntries[itemId]
                    local currentStock = stockInfo and stockInfo.Stock or 0
                    local stockColor = currentStock > 0 and "rgb(0,255,100)" or "rgb(255,100,100)"

                    lines[#lines + 1] = ("- %s | Harga: %s | Stok: %s"):format(
                        font("<b>" .. itemData.DisplayName .. "</b>", "rgb(255,255,255)"),
                        font("<b>" .. formatNumber(itemData.Price) .. "</b>", "rgb(255,220,80)"),
                        font("<b>" .. tostring(currentStock) .. "</b>", stockColor)
                    )
                end
            end
        end

        lines[#lines + 1] = ""
        lines[#lines + 1] = "Restock dalam: " .. font("<b>" .. formatCountdown(seconds) .. "</b>", "rgb(255,220,80)")
        lines[#lines + 1] = ""
        lines[#lines + 1] = "Status: " .. (state.running
            and font("<b>Berjalan</b>", "rgb(0,255,100)")
            or font("<b>Berhenti</b>", "rgb(200,200,200)"))

        return table.concat(lines, "\n")
    end

    local function pushStatus()
        if state.onStatus then
            pcall(state.onStatus, buildStatusText())
        end
    end

    function AutoBMHop.RefreshStatus()
        pushStatus()
    end

    function AutoBMHop.BindUpdates()
        local c1 = bmRep:OnChange("Items", pushStatus)
        local c2 = bmRep:OnChange("NextRestock", pushStatus)
        table.insert(_G._NEXTHUB.conns, c1)
        table.insert(_G._NEXTHUB.conns, c2)

        pcall(function()
            local coinPath = CurrencyUtility:GetCurrency("Coins").Path
            local c3 = playerDataRep:OnChange(coinPath, pushStatus)
            table.insert(_G._NEXTHUB.conns, c3)
        end)

        local updateLoop = task.spawn(function()
            while true do
                task.wait(1)
                pushStatus()
            end
        end)
        table.insert(_G._NEXTHUB.tasks, updateLoop)
    end

    local function buyUntilExhausted()
        local itemsToBuy = getAvailableItems()
        if #itemsToBuy == 0 then return false end

        local char = LP.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        local dealer = getDealerPart()
        if not (hrp and dealer) then return false end

        local oldCFrame = hrp.CFrame
        char:PivotTo(dealer.CFrame * CFrame.new(0, 5, -5))
        task.wait(2.5)

        while state.running do
            local currentAvailable = getAvailableItems()
            if #currentAvailable == 0 then break end

            for _, itemId in ipairs(currentAvailable) do
                if not state.running then break end
                pcall(function() RF_PurchaseItem:InvokeServer(itemId) end)
                task.wait(1.5)
            end

            task.wait(1)
        end

        task.wait(1)
        if hrp.Parent and oldCFrame then
            char:PivotTo(oldCFrame)
        end

        return true
    end

    local function fetchLowPopServers()
        if not serverBrowserRep then return {} end

        local ok, rawServers = pcall(function() return serverBrowserRep:GetExpect("Servers") end)
        if not ok or type(rawServers) ~= "table" then
            ok, rawServers = pcall(function() return serverBrowserRep:Get("Servers") end)
        end
        if not ok or type(rawServers) ~= "table" then return {} end

        local list = {}
        for jobId, data in pairs(rawServers) do
            if jobId ~= game.JobId and jobId ~= "" then
                table.insert(list, {
                    jobId   = jobId,
                    players = type(data.Players) == "number" and data.Players or 0,
                })
            end
        end

        table.sort(list, function(a, b) return a.players < b.players end)
        return list
    end

    local HOP_MAX_ATTEMPTS = 8
    local HOP_FAIL_TIMEOUT = 12

    local function hopToSmallServer()
        local candidates = fetchLowPopServers()
        if #candidates == 0 then
            warn("[AutoBMHop] Tidak ada server lain yang ditemukan")
            return false
        end

        local attempts    = math.min(HOP_MAX_ATTEMPTS, #candidates)
        local idx          = 0
        local doneCalled   = false
        local success       = false
        local failedConn   = nil
        local timeoutTask  = nil

        local function finish(ok)
            if doneCalled then return end
            doneCalled = true
            success = ok
            if failedConn then pcall(function() failedConn:Disconnect() end) end
            if timeoutTask then pcall(task.cancel, timeoutTask) end
        end

        local function tryNext()
            idx += 1
            local candidate = candidates[idx]
            if not candidate then
                finish(false)
                return
            end

            local fired = pcall(function()
                if hopRemote then
                    hopRemote:FireServer(candidate.jobId)
                else
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, candidate.jobId, LP)
                end
            end)

            if not fired then
                warn(("[AutoBMHop] Gagal fire hop ke %s, coba kandidat lain..."):format(candidate.jobId))
                task.wait(0.5)
                tryNext()
                return
            end

            print(("[AutoBMHop] Mencoba hop ke server %s (%d players)"):format(candidate.jobId, candidate.players))

            if timeoutTask then pcall(task.cancel, timeoutTask) end
            timeoutTask = task.delay(HOP_FAIL_TIMEOUT, function()
                finish(true)
            end)
        end

        failedConn = TeleportService.TeleportInitFailed:Connect(function(player, teleportResult)
            if player ~= LP or doneCalled then return end
            warn(("[AutoBMHop] Teleport gagal (%s), retry ke server lain..."):format(tostring(teleportResult)))
            task.wait(1)
            tryNext()
        end)

        tryNext()

        local waitStart = tick()
        while not doneCalled and (tick() - waitStart) < (HOP_FAIL_TIMEOUT + attempts * 3) do
            task.wait(0.2)
        end
        finish(false)

        return success
    end

    function AutoBMHop.Start()
        if state.running then return end
        if #state.selectedIds == 0 then
            warn("[AutoBMHop] Belum ada item yang dipilih & disimpan")
            return
        end

        state.running = true
        pushStatus()

        state.loopThread = task.spawn(function()
            task.wait(1)

            while state.running do
                local hasStock  = anyStockLeft()
                local canAfford = canAffordCheapest()

                if not canAfford then
                    warn("[AutoBMHop] Coin sudah tidak cukup lagi. Auto stop.")
                    break
                end

                if hasStock then
                    buyUntilExhausted()
                    task.wait(2)
                else
                    warn("[AutoBMHop] Item pilihan habis, server hop...")
                    task.wait(1)
                    local hopped = hopToSmallServer()

                    if hopped then
                        task.wait(5)
                        break
                    else
                        warn("[AutoBMHop] Semua percobaan hop gagal, coba lagi sebentar...")
                        task.wait(5)
                    end
                end
            end

            state.running    = false
            state.loopThread = nil
            pushStatus()
        end)

        table.insert(_G._NEXTHUB.tasks, state.loopThread)
    end

    function AutoBMHop.Stop()
        state.running = false
        if state.loopThread then
            pcall(task.cancel, state.loopThread)
            state.loopThread = nil
        end
        pushStatus()
    end
end

