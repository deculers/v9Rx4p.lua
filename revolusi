        Callback = function()
            applySelectionToLogic()
            task.wait(0.3)
            Window:SaveConfig(CONFIG_NAME)
            AutoBMHop.RefreshStatus()
        end
    })

    local toggleObj = nil

    local function tryStartLifecycle(isAutoResume)
        if not bmReady then
            Notifier("Black Market Auto", "Data Black Market belum siap", 4)
            if toggleObj then toggleObj:Set(false) end
            return
        end

        applySelectionToLogic()
        task.wait(0.3)

        if not AutoBMHop.HasSelection() then
            Notifier("Black Market Auto", "Pilih & simpan item dulu sebelum mulai", 4)
            if toggleObj then toggleObj:Set(false) end
            return
        end

        task.wait(0.5)
        AutoBMHop.Start()

        task.wait(0.2)
        Window:SaveConfig(CONFIG_NAME)

        if isAutoResume then
            Notifier("Black Market Auto", "Lifecycle dilanjutkan otomatis (AutoExecute)", 3)
        else
            Notifier("Black Market Auto", "Auto Buy + Hop dimulai", 3)
        end
    end

    toggleObj = Feature:AddToggle("BMH_Enabled", {
