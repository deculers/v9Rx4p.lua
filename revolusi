        Default = false,
        Callback = function(v)
            if v then
                tryStartLifecycle(false)
            else
                AutoBMHop.Stop()
                Notifier("Black Market Auto", "Auto Buy + Hop dihentikan", 3)

                task.wait(0.2)
                Window:SaveConfig(CONFIG_NAME)
